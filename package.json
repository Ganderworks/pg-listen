{
  "name": "pg-listen",
  "version": "2.0.0-ganderworks.1",
  "license": "MIT",
  "description": "PostgreSQL LISTEN & NOTIFY that finally works. Ganderworks fork: keeps reconnecting, catches half-open connections.",
  "author": "Andy Wermke (https://github.com/andywer)",
  "contributors": [
    "Ganderworks"
  ],
  "repository": "github:Ganderworks/pg-listen",
  "main": "./index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:database": "docker run -e POSTGRES_DB=postgres -e POSTGRES_PASSWORD=postgres -p 5432:5432 --rm postgres:16-alpine"
  },
  "keywords": [
    "postgres",
    "listen",
    "notify",
    "subscribe",
    "events"
  ],
  "peerDependencies": {
    "pg": "8.x"
  },
  "dependencies": {
    "debug": "^4.4.3"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.15.0",
    "pg": "^8.20.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.12"
  },
  "files": [
    "dist/**",
    "index.js"
  ]
}
